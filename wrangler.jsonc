{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "pdc-ax",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  // Static site served straight from the repo root; .assetsignore keeps repo files out.
  // run_worker_first so worker.js sees www requests before assets match.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
